[configuration]

entry_symbol = "kimodo_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]

; Limited to what kimodo.cpp itself supports. It needs a C++23 compiler and the
; GGML Vulkan backend, and the 8B LLM2Vec text encoder needs desktop-class VRAM,
; which rules out mobile and web. The upstream README builds on Linux, and
; CMakeLists.txt carries an MSVC branch, so x86_64 Linux and Windows are the
; two targets. Relative paths keep the addon self-contained, so a release is the
; addons/kimodo folder and nothing else.
;
; Single precision only: a double-precision Godot is a build somebody made
; themselves, and they can run scons precision=double as easily. Claiming the
; configuration here without shipping it only turns a clear "no library for this
; platform" into a missing file.

windows.x86_64.single.debug = "./bin/windows/kimodo.windows.template_debug.x86_64.dll"
windows.x86_64.single.release = "./bin/windows/kimodo.windows.template_release.x86_64.dll"

linux.x86_64.single.debug = "./bin/linux/libkimodo.linux.template_debug.x86_64.so"
linux.x86_64.single.release = "./bin/linux/libkimodo.linux.template_release.x86_64.so"
