 namespace {
+// Classifier-free guidance weights.  Both default to the 2.0 upstream samples
+// with, and both are read from the environment rather than argv: the two
+// command-line shapes below are told apart by position, and kimodo.cpp already
+// takes KIMODO_BACKEND, KIMODO_THREADS and KIMODO_TEXT_LAYER_CHUNK this way.
+//
+// KIMODO_CONSTRAINT_CFG only reaches a sequence.  A single prompt is sampled
+// unconstrained, where the constraint branch of the separated CFG is handed the
+// same input as the unconditional one and their difference is zero.
+float guidance(const char *name) {
+    const char *value = std::getenv(name);
+    if (!value || !*value) return 2.F;
+    try {
+        const float weight = std::stof(value);
+        if (std::isfinite(weight)) return weight;
+    } catch (const std::exception &) {
+    }
+    std::cerr << name << "=" << value << " is not a number; using 2.0\n";
+    return 2.F;
+}
+
