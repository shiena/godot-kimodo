# Godot auto generated files
*.gen.*
.godot/

# GodotHub records which engine it launched this project with
.godotrc

# Ignore built libraries. The .gdextension that describes them is tracked, and
# lives in the addon next to the bin/ it points at.
/bin/**

# Ignore generated motion: the sample fixture, a real clip kept for checking
# against, and whatever kimodo/output/root points at inside the project
/project/motion_sample/
/project/motion_real/
/project/kimodo_out/

# Ignore what scons puts in the addon: the extension, kmd-generate and the
# shared libraries they load, and the converter it copies out of kimodo.cpp
/project/addons/kimodo/bin/
/project/addons/kimodo/scripts/

# Ignore scons database
.sconsign*.dblite

# Ignore custom.py
custom.py

# Ignore generated compile_commands.json
compile_commands.json

# Ignore files generated for documentation
/src/gen

# Binaries
*.o
*.os
*.so
*.obj
*.bc
*.pyc
*.dblite
*.pdb
*.lib
*.config
*.creator
*.creator.user
*.files
*.includes
*.idb
*.exp

# Other stuff
*.log

# VSCode
.vscode/*
!.vscode/extensions.json
.DS_Store

# Jetbrains
.idea/

# Cmake
cmake-build*
CMakeUserPresets.json
